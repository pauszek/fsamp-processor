{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pauszek/fsamp-event-schema/event.schema.json",
  "title": "FSAMP Secure Event",
  "description": "Canonical event contract for the FSAMP file-processing flow.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "Exact version of the event contract.",
      "type": "string",
      "const": "1.2.0"
    },
    "fileId": {
      "description": "Stable aggregate identifier for the file (UUID v4).",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventId": {
      "description": "Unique identifier for this event occurrence (UUID v4 or v5).",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "correlationId": {
      "description": "Trace identifier propagated across the complete flow (UUID v4).",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "description": "Event occurrence timestamp in UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source": {
      "description": "Service that produced the event.",
      "type": "string",
      "enum": [
        "fsamp-gateway",
        "fsamp-processor"
      ]
    },
    "eventType": {
      "description": "Discriminator for the event payload and producer.",
      "type": "string",
      "enum": [
        "FILE_UPLOADED",
        "FILE_SCANNED",
        "ANALYSIS_COMPLETED",
        "PROCESSING_FAILED"
      ]
    },
    "fileMetadata": {
      "type": "object",
      "description": "Canonical metadata for the processed file.",
      "additionalProperties": false,
      "properties": {
        "originalFilename": {
          "description": "Original name of the uploaded file.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^<>:\"/\\\\|?*\\x00-\\x1f]+$"
        },
        "fileSizeBytes": {
          "description": "Size of the file in bytes.",
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "mimeType": {
          "description": "MIME type detected from the file content.",
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+$"
        },
        "checksumSHA256": {
          "description": "SHA-256 hash of the file content (FIPS 180-4).",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "originalFilename",
        "fileSizeBytes",
        "checksumSHA256"
      ]
    },
    "storageLocation": {
      "type": "object",
      "description": "Claim-check pointer to the physical object.",
      "additionalProperties": false,
      "properties": {
        "bucketName": {
          "description": "Valid S3 general-purpose bucket name.",
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^(?!\\d{1,3}(?:\\.\\d{1,3}){3}$)(?!.*\\.\\.)(?!.*\\.-)(?!.*-\\.)[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "objectKey": {
          "description": "S3 object key within the bucket.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "region": {
          "description": "AWS region containing the bucket.",
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[a-z0-9]+)+-\\d$"
        }
      },
      "required": [
        "bucketName",
        "objectKey"
      ]
    },
    "securityContext": {
      "type": "object",
      "description": "Cryptographic metadata for the SSE-KMS protected object.",
      "additionalProperties": false,
      "properties": {
        "isEncrypted": {
          "description": "Whether the file is encrypted at rest.",
          "type": "boolean",
          "const": true
        },
        "encryptionAlgorithm": {
          "description": "FSAMP cryptographic policy identifier.",
          "type": "string",
          "const": "AES/GCM/NoPadding"
        },
        "kmsKeyId": {
          "description": "ARN of the AWS KMS key used by S3, including multi-Region keys.",
          "type": "string",
          "pattern": "^arn:(aws|aws-us-gov):kms:[a-z0-9-]+:\\d{12}:key/(?:[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}|mrk-[a-f0-9]{32})$"
        }
      },
      "required": [
        "isEncrypted",
        "encryptionAlgorithm",
        "kmsKeyId"
      ]
    },
    "processingResult": {
      "type": "object",
      "description": "Result produced when file analysis completes.",
      "additionalProperties": false,
      "properties": {
        "isSafe": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "processedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "fileHashSHA256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scanEngine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "isSafe",
        "findings",
        "processedAt"
      ]
    },
    "failure": {
      "type": "object",
      "description": "Terminal processing failure details.",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "failedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "failedAt",
        "retryable"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "fileId",
    "eventId",
    "correlationId",
    "timestamp",
    "source",
    "eventType",
    "fileMetadata",
    "storageLocation",
    "securityContext"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "FILE_UPLOADED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "fsamp-gateway"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "processingResult"
              ]
            },
            {
              "required": [
                "failure"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "FILE_SCANNED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "fsamp-processor"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "processingResult"
              ]
            },
            {
              "required": [
                "failure"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "ANALYSIS_COMPLETED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "fsamp-processor"
          }
        },
        "required": [
          "processingResult"
        ],
        "not": {
          "required": [
            "failure"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "PROCESSING_FAILED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "fsamp-processor"
          }
        },
        "required": [
          "failure"
        ],
        "not": {
          "required": [
            "processingResult"
          ]
        }
      }
    }
  ]
}
