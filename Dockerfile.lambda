# =============================================================================
# FSAMP Processor - Lambda Container Image (Chainguard)
# =============================================================================
# Docker image for AWS Lambda deployment using Lambda Runtime Interface Client.
# Based on Chainguard Python image - hardened, minimal, zero known CVEs.
#
# Build:
#   docker build -f Dockerfile.lambda -t fsamp-processor-lambda .
#
# Local testing with RIE (Runtime Interface Emulator):
#   docker run -p 9000:8080 fsamp-processor-lambda
#   curl -X POST "http://localhost:9000/2015-03-31/functions/function/invocations" \
#     -d @events/sample-sqs-event.json
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder - compile dependencies using glibc-compatible image
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest-dev AS builder

USER root

WORKDIR /build
COPY pyproject.toml .
COPY src/ src/

# Install dependencies to /asset directory
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --target /asset . && \
    pip install --no-cache-dir --target /asset awslambdaric

# -----------------------------------------------------------------------------
# Stage 2: Lambda Runtime - Chainguard minimal (zero CVE)
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest

# Set up Lambda runtime directory structure
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
WORKDIR ${LAMBDA_TASK_ROOT}

# Labels
LABEL maintainer="Pauszek <pauszek@github.io>"
LABEL org.opencontainers.image.title="FSAMP Processor Lambda"
LABEL org.opencontainers.image.description="Event-driven file processor Lambda"
LABEL org.opencontainers.image.version="0.1.0"

# Copy dependencies (includes awslambdaric)
COPY --from=builder /asset ${LAMBDA_TASK_ROOT}

# Copy source code
COPY src/processor ${LAMBDA_TASK_ROOT}/processor

# Lambda Runtime Interface Client entrypoint
ENTRYPOINT ["python", "-m", "awslambdaric"]
CMD ["processor.lambda_handler.lambda_handler"]

# =============================================================================
# Environment variables (can be overridden at runtime)
# =============================================================================
ENV POWERTOOLS_SERVICE_NAME=fsamp-processor \
    POWERTOOLS_METRICS_NAMESPACE=FSAMP/Processor \
    POWERTOOLS_LOG_LEVEL=INFO \
    LOG_FORMAT=json \
    ENVIRONMENT=prod
