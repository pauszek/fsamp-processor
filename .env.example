# =============================================================================
# FSAMP Processor - Environment Configuration
# =============================================================================
# Copy to .env and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack endpoint (comment out for real AWS)
AWS_ENDPOINT_URL=http://localhost:4566

# -----------------------------------------------------------------------------
# Resource ARNs/URLs (populated by Terraform)
# -----------------------------------------------------------------------------
SQS_QUEUE_URL=http://localhost:4566/000000000000/fsamp-local-processing-queue
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:000000000000:fsamp-local-file-events
S3_BUCKET_NAME=fsamp-local-files
DYNAMODB_TABLE_NAME=fsamp-local-metadata
KMS_KEY_ID=alias/fsamp-local-master-key

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# SQS Consumer settings
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300

# Processing settings
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_DELAY_SECONDS=5
